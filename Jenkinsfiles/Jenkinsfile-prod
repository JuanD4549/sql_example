pipeline {

    agent any

    parameters {

        choice(
            name: 'DATABASE',
            choices: [
                'CORE',
                'FACTURACION',
                'LOGISTICA',
                'REPORTES',
                'INTEGRACION'
            ]
        )

    }

    stages {

        stage('CAB Approval') {

            steps {

                input(
                    message: 'Aprobar salida a producción?',
                    submitter: 'dba,qa_lead'
                )

            }

        }

        stage('Generate Deployment SQL') {

            steps {

                sh """
                   liquibase \
                   --defaultsFile=environments/PROD/${params.DATABASE.toLowerCase()}.properties \
                   updateSQL > prod_deployment.sql
                """
            }

        }

        stage('Deploy PROD') {

            steps {

                sh """
                   liquibase \
                   --defaultsFile=environments/PROD/${params.DATABASE.toLowerCase()}.properties \
                   update
                """

            }

        }

    }

    post {

        always {
            archiveArtifacts '*.sql'
        }

    }

}